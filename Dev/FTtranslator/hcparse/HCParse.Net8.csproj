<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FieldWorks' HermitCrab word parsing for .NET 8, so FTtranslator can parse source words on Linux. HcWordParser.cs ports HCParser.ParseWord() and its helpers (FTOffline compiles it in too), Program.cs is the read-parse-write loop; the trace manager and the FieldWorks
    shims are shared with ../hcsynth, which builds HCSynthByGloss from FieldWorks' source. SIL.Machine is pinned to 3.9.5, the version FieldWorks 9.3.12 installs.
    Build: dotnet publish -c Release -o out
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>HCParse</AssemblyName>
    <RootNamespace>FTtranslator.HCParse</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="HcWordParser.cs" />
    <Compile Include="../hcsynth/upstream/HCSynthByGlossLib/HcXmlTraceManager.cs" />
    <Compile Include="../hcsynth/upstream/HCSynthByGlossLib/ISynTraceManager.cs" />
    <Compile Include="../hcsynth/FieldWorksShims.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIL.Machine" Version="3.9.5" />
    <PackageReference Include="SIL.Machine.Morphology.HermitCrab" Version="3.9.5" />
  </ItemGroup>

</Project>
