<?xml version="1.0" encoding="utf-8"?>
<!--
	No permissions: the app translates on the phone and never uses the network.
	localeConfig lists the UI languages (Resources/xml/locales_config.xml, generated by Dev/updateLanguageFiles.py), so Android 13+ offers the app its own language in Settings.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:localeConfig="@xml/locales_config"></application>
</manifest>
