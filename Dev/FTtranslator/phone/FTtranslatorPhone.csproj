<Project Sdk="Microsoft.NET.Sdk">

	<!--
		FTtranslator for phones: type a sentence, get its translation, translated on the phone by FTOffline (../offline) from a bundle on the phone. No network. Android and iOS. A trimmed-down
		screen (the translation and a history of earlier ones) unless trace mode is on, which adds each translation's run record and Apertium streams. See README.md.

		iOS is a target only on a Mac (or with -p:IncludeIos=true), since an iOS build needs Xcode and restoring it needs the ios workload; Windows builds Android alone without either.

		The bundles: the build zips each bundle folder (export-bundle's Output\ftt_bundle) named in BundleDirs, separated by semicolons, into the app as bundle-<hash>.zip, and lists them in
		bundles.txt; the app unpacks them on first run, or whenever a zip has changed (Bundles.cs). FTT-Scratch's ../deploy/bundle unless -p:BundleDirs names others. More can be added on the
		phone from a zip.
	-->

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(IncludeIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>FTtranslator.Phone</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>FTtranslator</ApplicationTitle>
		<ApplicationId>org.sil.fttranslator</ApplicationId>
		<ApplicationDisplayVersion>3.17</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<!-- FTOffline's loaders and hcparse's HcWordParser.cs use reflection-based System.Text.Json, which trimmed builds turn off unless told otherwise. The app's own JSON (the history) is source-generated. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

		<!-- The bundle folders zipped into the app. See the comment at the top. -->
		<BundleDirs Condition="'$(BundleDirs)' == ''">$(MSBuildProjectDirectory)\..\deploy\bundle</BundleDirs>
		<BundlesOut>$(BaseIntermediateOutputPath)bundles\$(TargetFramework)\</BundlesOut>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<!--
		The UI strings: AppResources.resx (English) and one AppResources.<code>.resx per other UI language, which the build makes into satellite assemblies on Android and iOS alike. MSBuild
		writes the AppResources class from the English file (no Visual Studio generator, so `dotnet build` does it too): XAML reaches a string as {x:Static res:AppResources.Translate}, C# as
		AppResources.Translate. The trace isn't translated. See README.md's Languages section.
	-->
	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings\AppResources.resx" StronglyTypedFileName="$(IntermediateOutputPath)AppResources.Designer.cs" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="FTtranslator.Phone.Resources.Strings" StronglyTypedClassName="AppResources" PublicClass="true" />
	</ItemGroup>

	<!--
		iOS. iOS allows no JIT, so everything is compiled ahead of time; -all keeps the interpreter in the app as well, but interprets nothing that could be compiled ahead of time. It runs only
		code that can't be compiled that way, which would otherwise stop the app with an ExecutionEngineException ("Attempting to JIT compile method ..."). SIL.Machine's generic code over value types
		and FTOffline's reflection-based JSON are the likely cases, which Android never showed, since Android has a JIT. Localizations.plist (generated by Dev/updateLanguageFiles.py) adds the UI
		languages to Info.plist as CFBundleLocalizations; without it iOS treats the app as English only. Platforms/iOS/Resources/PrivacyInfo.xcprivacy is packed by the platform-folder default.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<MtouchInterpreter>-all</MtouchInterpreter>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PartialAppManifest Include="Platforms\iOS\Localizations.plist" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\offline\FTOffline.csproj" />
	</ItemGroup>

	<!--
		Zip each bundle folder's contents (not the folder itself, as upload-bundle zips them) and list the zips in bundles.txt, then add them as app assets. The zips are named by a hash of the
		folder's path, since every export-bundle folder is called ftt_bundle. Zipped again on every build: a few seconds for a big bundle, and never a stale bundle. The folder isn't emptied first
		(something else may have one open); a zip left from an earlier build isn't in bundles.txt, so it isn't packed. It runs only in the build that packs the app's assets: not in a Release
		build's per-processor builds (RuntimeIdentifier set), which run side by side and would all write the same zips at once, nor in the editor's design-time builds; neither needs the zips.
		An iOS build always has a RuntimeIdentifier (it builds for one processor), so it runs there regardless. Each target framework zips into its own folder, since a Mac build without -f
		builds Android and iOS side by side.
	-->
	<Target Name="ZipBundles" BeforeTargets="PrepareForBuild" Condition="('$(RuntimeIdentifier)' == '' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios') And '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<PackagedBundle Include="$(BundleDirs)" />
			<PackagedBundle>
				<ZipName>bundle-$([MSBuild]::StableStringHash('%(FullPath)'))</ZipName>
			</PackagedBundle>
		</ItemGroup>

		<Error Condition="!Exists('%(PackagedBundle.FullPath)\manifest.json')" Text="%(PackagedBundle.FullPath) is not a bundle folder (it has no manifest.json). Pass -p:BundleDirs=&lt;export-bundle's Output\ftt_bundle&gt;;&lt;another&gt;." />
		<MakeDir Directories="$(BundlesOut)" />
		<ZipDirectory SourceDirectory="%(PackagedBundle.FullPath)" DestinationFile="$(BundlesOut)%(PackagedBundle.ZipName).zip" Overwrite="true" />
		<WriteLinesToFile File="$(BundlesOut)bundles.txt" Lines="@(PackagedBundle->'%(ZipName).zip')" Overwrite="true" />

		<ItemGroup>
			<MauiAsset Include="$(BundlesOut)%(PackagedBundle.ZipName).zip" LogicalName="%(PackagedBundle.ZipName).zip" />
			<MauiAsset Include="$(BundlesOut)bundles.txt" LogicalName="bundles.txt" />
		</ItemGroup>
	</Target>

</Project>
