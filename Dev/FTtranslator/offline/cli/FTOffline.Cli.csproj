<Project Sdk="Microsoft.NET.Sdk">

  <!-- ftoffline: the command line for FTOffline (translate a text from a bundle, or check every step against the Python translator's recorded stages). See Program.cs and ../README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ftoffline</AssemblyName>
    <RootNamespace>FTtranslator.Offline.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FTOffline.csproj" />
  </ItemGroup>

</Project>
