<transfer>
	<section-def-cats>
		<def-cat n="c_AdjMF">
			<cat-item tags="AdjMF" />
			<cat-item tags="AdjMF.*" />
		</def-cat>
		<def-cat n="c_adj">
			<cat-item tags="adj" />
			<cat-item tags="adj.*" />
		</def-cat>
		<def-cat n="c_adv">
			<cat-item tags="adv" />
			<cat-item tags="adv.*" />
		</def-cat>
		<def-cat n="c_aux">
			<cat-item tags="aux" />
			<cat-item tags="aux.*" />
		</def-cat>
		<def-cat n="c_conj">
			<cat-item tags="conj" />
			<cat-item tags="conj.*" />
		</def-cat>
		<def-cat n="c_coordconj">
			<cat-item tags="coordconj" />
			<cat-item tags="coordconj.*" />
		</def-cat>
		<def-cat n="c_cop">
			<cat-item tags="cop" />
			<cat-item tags="cop.*" />
		</def-cat>
		<def-cat n="c_det">
			<cat-item tags="indf" />
			<cat-item tags="indf.*" />
			<cat-item tags="dem" />
			<cat-item tags="dem.*" />
		</def-cat>
		<def-cat n="c_def">
			<cat-item tags="def" />
			<cat-item tags="def.*" />
		</def-cat>
		<def-cat n="c_dem">
			<cat-item tags="dem" />
			<cat-item tags="dem.*" />
		</def-cat>
		<def-cat n="c_def_or_indef">
			<cat-item tags="def" />
			<cat-item tags="def.*" />
			<cat-item tags="indf" />
			<cat-item tags="indf.*" />
		</def-cat>
		<def-cat n="c_existmrkr">
			<cat-item tags="existmrkr" />
			<cat-item tags="existmrkr.*" />
		</def-cat>
		<def-cat n="c_indef">
			<cat-item tags="indf" />
			<cat-item tags="indf.*" />
		</def-cat>
		<def-cat n="c_n">
			<cat-item tags="n" />
			<cat-item tags="n.*" />
		</def-cat>
		<def-cat n="c_nprop">
			<cat-item tags="nprop" />
			<cat-item tags="nprop.*" />
		</def-cat>
		<def-cat n="c_pers">
			<cat-item tags="pers" />
			<cat-item tags="pers.*" />
		</def-cat>
		<def-cat n="c_poss">
			<cat-item tags="poss" />
			<cat-item tags="poss.*" />
		</def-cat>
		<def-cat n="c_prep">
			<cat-item tags="prep" />
			<cat-item tags="prep.*" />
		</def-cat>
		<def-cat n="c_prepart">
			<cat-item tags="prepart" />
			<cat-item tags="prepart.*" />
		</def-cat>
		<def-cat n="c_pro">
			<cat-item tags="pro" />
			<cat-item tags="pro.*" />
		</def-cat>
		<def-cat n="c_prt">
			<cat-item tags="prt" />
			<cat-item tags="prt.*" />
		</def-cat>
		<def-cat n="c_quant">
			<cat-item tags="quant" />
			<cat-item tags="quant.*" />
		</def-cat>
		<def-cat n="c_subordconj">
			<cat-item tags="subordconj" />
			<cat-item tags="subordconj.*" />
		</def-cat>
		<def-cat n="c_v">
			<cat-item tags="v" />
			<cat-item tags="v.*" />
		</def-cat>
		<def-cat n="c_v_or_cop">
			<cat-item tags="v" />
			<cat-item tags="v.*" />
			<cat-item tags="cop" />
			<cat-item tags="cop.*" />
		</def-cat>
		<def-cat n="c_v_disable">
			<cat-item tags="v-disable" />
		</def-cat>
	</section-def-cats>
	<section-def-attrs>
		<def-attr n="a_Adjective_class">
			<attr-item tags="NoGen" />
		</def-attr>
		<def-attr n="a_aGen_slot">
			<attr-item tags="FEM_a" />
			<attr-item tags="MASC_a" />
		</def-attr>
		<def-attr n="a_aMFNum_slot">
			<attr-item tags="PL" />
			<attr-item tags="PL2" />
			<attr-item tags="PL3" />
			<attr-item tags="PL4" />
			<attr-item tags="SG" />
			<attr-item tags="SG1" />
			<attr-item tags="SG2" />
			<attr-item tags="SG3" />
			<attr-item tags="SG4" />
		</def-attr>
		<def-attr n="a_aNum_slot">
			<attr-item tags="PL" />
			<attr-item tags="SG" />
		</def-attr>
		<def-attr n="a_case_feature">
			<attr-item tags="acc" />
			<attr-item tags="dat" />
			<attr-item tags="nom" />
		</def-attr>
		<def-attr n="a_dGen_slot">
			<attr-item tags="FEM" />
			<attr-item tags="MASC" />
		</def-attr>
		<def-attr n="a_dNum_slot">
			<attr-item tags="PL" />
			<attr-item tags="SG" />
		</def-attr>
		<def-attr n="a_gender_feature">
			<attr-item tags="?" />
			<attr-item tags="f" />
			<attr-item tags="m" />
		</def-attr>
		<def-attr n="a_gram_cat">
			<attr-item c="Adjective" tags="adj" />
			<attr-item c="Adjective No Gender" tags="AdjMF" />
			<attr-item c="Adverb" tags="adv" />
			<attr-item c="Auxiliary verb" tags="aux" />
			<attr-item c="Conjunction" tags="conj" />
			<attr-item c="Coordinating conjuncion" tags="coordconj" />
			<attr-item c="Copulative verb" tags="cop" />
			<attr-item c="Definite article" tags="def" />
			<attr-item c="Determiner" tags="det" />
			<attr-item c="Existential marker" tags="existmrkr" />
			<attr-item c="Indefinite article" tags="indef" />
			<attr-item c="Noun" tags="n" />
			<attr-item c="Proper  Noun" tags="nprop" />
			<attr-item c="Personal pronoun" tags="pers" />
			<attr-item c="Possessive pronoun" tags="poss" />
			<attr-item c="Preposition" tags="prep" />
			<attr-item c="Preposition plus Article" tags="prepart" />
			<attr-item c="Pronoun" tags="pro" />
			<attr-item c="Particle" tags="prt" />
			<attr-item c="Quantifier" tags="quant" />
			<attr-item c="Subordinating conjunction" tags="subordconj" />
			<attr-item c="Verb" tags="v" />
			<attr-item tags="indf" />
			<attr-item tags="dem" />
		</def-attr>
		<def-attr n="a_indef_number_slot">
			<attr-item tags="PL" />
			<attr-item tags="SG" />
		</def-attr>
		<def-attr n="a_nNum_slot">
			<attr-item tags="PL" />
			<attr-item tags="SG" />
		</def-attr>
		<def-attr n="a_number_feature">
			<attr-item tags="pl" />
			<attr-item tags="sg" />
		</def-attr>
		<def-attr n="a_person_feature">
			<attr-item tags="1" />
			<attr-item tags="2" />
			<attr-item tags="3" />
		</def-attr>
		<def-attr n="a_Ptcpl_slot">
			<attr-item tags="INF" />
			<attr-item tags="Prog" />
			<attr-item tags="PstPrf" />
		</def-attr>
		<def-attr n="a_Verb_class">
			<attr-item tags="AR" />
			<attr-item tags="ER" />
			<attr-item tags="IR" />
			<attr-item tags="PretSfxER" />
			<attr-item tags="PretSfxIR" />
		</def-attr>
		<def-attr n="a_Verb_feature">
			<attr-item tags="tr" />
			<attr-item tags="intr" />
			<attr-item tags="ditr" />
			<attr-item tags="ipfv" />
		</def-attr>
		<def-attr n="a_vTnsPersNum_slot">
			<attr-item tags="INF" />
			<attr-item tags="PastPrf" />
			<attr-item tags="Prog" />
			<attr-item tags="FUT_1PL" />
			<attr-item tags="FUT_1SG" />
			<attr-item tags="FUT_2SG_FAM" />
			<attr-item tags="FUT_3PL" />
			<attr-item tags="FUT_3SG" />
			<attr-item tags="IMPFV_1PL" />
			<attr-item tags="IMPFV_1SG" />
			<attr-item tags="IMPFV_2SG_FAM" />
			<attr-item tags="IMPFV_3PL" />
			<attr-item tags="IMPFV_3SG" />
			<attr-item tags="PRS_1PL" />
			<attr-item tags="PRS_1SG" />
			<attr-item tags="PRS_2SG_FAM" />
			<attr-item tags="PRS_3PL" />
			<attr-item tags="PRS_3SG" />
			<attr-item tags="PST_1PL" />
			<attr-item tags="PST_1SG" />
			<attr-item tags="PST_2SG_FAM" />
			<attr-item tags="PST_3PL" />
			<attr-item tags="PST_3SG" />
		</def-attr>
	</section-def-attrs>
	<section-def-vars>
		<def-var n="v_adj_gender" />
		<def-var n="v_det_gender" />
		<def-var n="v_det_number" />
		<def-var n="v_adj_number" />
	</section-def-vars>
	<section-def-macros>
		<def-macro n="m_delete_det_features" npar="1">
			<let>
				<clip part="a_gender_feature" pos="1" side="tl" />
				<lit v="" />
			</let>
			<let>
				<clip part="a_number_feature" pos="1" side="tl" />
				<lit v="" />
			</let>
			<let>
				<clip part="a_case_feature" pos="1" side="tl" />
				<lit v="" />
			</let>
		</def-macro>
		<def-macro n="m_delete_v_tags" npar="1">
			<let>
				<clip part="a_Verb_class" pos="1" side="tl" />
				<lit v="" />
			</let>
			<let>
				<clip part="a_Verb_feature" pos="1" side="tl" />
				<lit v="" />
			</let>
		</def-macro>
		<def-macro n="m_n_number-to-det_number" npar="1">
			<let>
				<var n="v_det_number" />
				<lit v="" />
			</let>
			<choose>
				<when>
					<test>
						<equal>
							<clip part="a_aMFNum_slot" pos="1" side="tl" />
							<lit-tag v="SG" />
						</equal>
					</test>
					<let>
						<var n="v_det_number" />
						<lit-tag v="SG2" />
					</let>
				</when>
				<when>
					<test>
						<equal>
							<clip part="a_aMFNum_slot" pos="1" side="tl" />
							<lit-tag v="PL" />
						</equal>
					</test>
					<let>
						<var n="v_det_number" />
						<lit-tag v="PL3" />
					</let>
				</when>
				<otherwise>
					<let>
						<var n="v_det_number" />
						<lit-tag v="number-UNK" />
					</let>
				</otherwise>
			</choose>
		</def-macro>
		<def-macro n="m_n_gender-to-det_gender" npar="1">
			<let>
				<var n="v_det_gender" />
				<lit v="" />
			</let>
			<choose>
				<when>
					<test>
						<equal>
							<clip part="a_gender_feature" pos="1" side="tl" />
							<lit-tag v="m" />
						</equal>
					</test>
					<let>
						<var n="v_det_gender" />
						<lit-tag v="MASC" />
					</let>
				</when>
				<when>
					<test>
						<equal>
							<clip part="a_gender_feature" pos="1" side="tl" />
							<lit-tag v="f" />
						</equal>
					</test>
					<let>
						<var n="v_det_gender" />
						<lit-tag v="FEM" />
					</let>
				</when>
				<otherwise>
					<let>
						<var n="v_det_gender" />
						<lit-tag v="gender-UNK" />
					</let>
				</otherwise>
			</choose>
		</def-macro>
		<def-macro n="m_n_gender-to-adj_gender" npar="1">
			<let>
				<var n="v_adj_gender" />
				<lit v="" />
			</let>
			<choose>
				<when>
					<test>
						<equal>
							<clip part="a_gender_feature" pos="1" side="tl" />
							<lit-tag v="m" />
						</equal>
					</test>
					<let>
						<var n="v_adj_gender" />
						<lit-tag v="MASC_a" />
					</let>
				</when>
				<when>
					<test>
						<equal>
							<clip part="a_gender_feature" pos="1" side="tl" />
							<lit-tag v="f" />
						</equal>
					</test>
					<let>
						<var n="v_adj_gender" />
						<lit-tag v="FEM_a" />
					</let>
				</when>
				<otherwise>
					<let>
						<var n="v_adj_gender" />
						<lit-tag v="gender-UNK" />
					</let>
				</otherwise>
			</choose>
		</def-macro>
		<def-macro n="m_n_number-to-adj_number" npar="1">
			<let>
				<var n="v_adj_number" />
				<lit v="" />
			</let>
			<choose>
				<when>
					<test>
						<equal>
							<clip part="a_aMFNum_slot" pos="1" side="tl" />
							<lit-tag v="SG" />
						</equal>
					</test>
					<let>
						<var n="v_adj_number" />
						<lit-tag v="SG3" />
					</let>
				</when>
				<when>
					<test>
						<equal>
							<clip part="a_aMFNum_slot" pos="1" side="tl" />
							<lit-tag v="PL" />
						</equal>
					</test>
					<let>
						<var n="v_adj_number" />
						<lit-tag v="PL2" />
					</let>
				</when>
				<otherwise>
					<let>
						<var n="v_adj_number" />
						<lit-tag v="number-UNK" />
					</let>
				</otherwise>
			</choose>
		</def-macro>
	</section-def-macros>
	<section-rules>
		<rule comment="Def">
			<pattern>
				<pattern-item n="c_def" />
			</pattern>
			<action>
				<call-macro n="m_delete_det_features">
					<with-param pos="1" />
				</call-macro>
				<out>
					<lu>
						<clip part="whole" pos="1" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="pro">
			<pattern>
				<pattern-item n="c_pro" />
			</pattern>
			<action>
				<call-macro n="m_delete_det_features">
					<with-param pos="1" />
				</call-macro>
				<out>
					<lu>
						<clip part="whole" pos="1" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="v or cop">
			<pattern>
				<pattern-item n="c_v_or_cop" />
			</pattern>
			<action>
				<call-macro n="m_delete_v_tags">
					<with-param pos="1" />
				</call-macro>
				<out>
					<lu>
						<clip part="whole" pos="1" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="Verb - remove features">
			<pattern>
				<pattern-item n="c_v_disable" />
			</pattern>
			<action>
				<out>
					<lu>
						<clip part="lem" pos="1" side="tl" />
						<clip part="a_gram_cat" pos="1" side="tl" />
						<clip part="a_vTnsPersNum_slot" pos="1" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="Det Adj N: det adj n">
			<pattern>
				<pattern-item n="c_det" />
				<pattern-item n="c_adj" />
				<pattern-item n="c_n" />
			</pattern>
			<action>
				<call-macro n="m_n_gender-to-det_gender">
					<with-param pos="3" />
				</call-macro>
				<call-macro n="m_n_number-to-det_number">
					<with-param pos="3" />
				</call-macro>
				<out>
					<lu>
						<clip part="lem" pos="1" side="tl" />
						<clip part="a_gram_cat" pos="1" side="tl" />
						<var n="v_det_gender" />
						<var n="v_det_number" />
					</lu>
				</out>
				<out>
					<b />
					<lu>
						<clip part="lem" pos="3" side="tl" />
						<clip part="a_gram_cat" pos="3" side="tl" />
						<clip part="a_aMFNum_slot" pos="3" side="tl" />
					</lu>
				</out>
				<call-macro n="m_n_gender-to-adj_gender">
					<with-param pos="3" />
				</call-macro>
				<call-macro n="m_n_number-to-adj_number">
					<with-param pos="3" />
				</call-macro>
				<out>
					<b />
					<lu>
						<clip part="lem" pos="2" side="tl" />
						<clip part="a_gram_cat" pos="2" side="tl" />
						<var n="v_adj_gender" />
						<var n="v_adj_number" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="Det Adj N: adj n">
			<pattern>
				<pattern-item n="c_adj" />
				<pattern-item n="c_n" />
			</pattern>
			<action>
				<out>
					<lu>
						<get-case-from pos="1">
							<clip part="lem" pos="2" side="tl" />
						</get-case-from>
						<clip part="a_gram_cat" pos="2" side="tl" />
						<clip part="a_aMFNum_slot" pos="2" side="tl" />
					</lu>
				</out>
				<call-macro n="m_n_gender-to-adj_gender">
					<with-param pos="2" />
				</call-macro>
				<call-macro n="m_n_number-to-adj_number">
					<with-param pos="2" />
				</call-macro>
				<out>
					<b />
					<lu>
						<get-case-from pos="2">
							<clip part="lem" pos="1" side="tl" />
						</get-case-from>
						<clip part="a_gram_cat" pos="1" side="tl" />
						<var n="v_adj_gender" />
						<var n="v_adj_number" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="Det Adj N: det n">
			<pattern>
				<pattern-item n="c_det" />
				<pattern-item n="c_n" />
			</pattern>
			<action>
				<call-macro n="m_n_gender-to-det_gender">
					<with-param pos="2" />
				</call-macro>
				<call-macro n="m_n_number-to-det_number">
					<with-param pos="2" />
				</call-macro>
				<out>
					<lu>
						<clip part="lem" pos="1" side="tl" />
						<clip part="a_gram_cat" pos="1" side="tl" />
						<var n="v_det_gender" />
						<var n="v_det_number" />
					</lu>
				</out>
				<out>
					<b />
					<lu>
						<clip part="lem" pos="2" side="tl" />
						<clip part="a_gram_cat" pos="2" side="tl" />
						<clip part="a_aMFNum_slot" pos="2" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
		<rule comment="Det Adj N: n">
			<pattern>
				<pattern-item n="c_n" />
			</pattern>
			<action>
				<out>
					<lu>
						<clip part="lem" pos="1" side="tl" />
						<clip part="a_gram_cat" pos="1" side="tl" />
						<clip part="a_aMFNum_slot" pos="1" side="tl" />
					</lu>
				</out>
			</action>
		</rule>
	</section-rules>
</transfer>