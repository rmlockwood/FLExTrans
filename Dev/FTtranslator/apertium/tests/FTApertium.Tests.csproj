<Project Sdk="Microsoft.NET.Sdk">

  <!-- FTApertium's unit tests: the fixtures in fixtures/ (made with the Windows Apertium tools by make_fixtures.py) checked through ReferenceCheck and ApertiumTransfer. Run: dotnet test -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FTtranslator.Apertium.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Where the fixtures are, so the tests read them in place rather than from a copy -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FixturesDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)fixtures</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FTApertium.csproj" />
  </ItemGroup>

</Project>
